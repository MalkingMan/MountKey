# ============================================================
# MOUNTKEY ENVIRONMENT CONFIGURATION
# ============================================================
# Copy file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_PORT=3309
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=mount_key

# API Key Configuration
API_KEY_PREFIX=mk_live_
API_KEY_LENGTH=32
