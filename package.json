{
  "name": "mountkey-api",
  "version": "1.0.0",
  "description": "MountKey - API Platform Data Gunung & Jalur Pendakian Indonesia",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:api": "set PORT=3001 && nodemon src/server.js",
    "dev:web": "cd web && npm run dev",
    "dev:admin": "cd admin && npm run dev",
    "dev:all": "concurrently -n API,WEB,ADMIN -c blue,green,yellow \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:admin\""
  },
  "keywords": [
    "api",
    "mountain",
    "hiking",
    "indonesia"
  ],
  "author": "MountKey Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.2"
  }
}